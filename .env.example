# FLAME Ads is opt-in for preview/staging. Set false for an instant kill switch.
NEXT_PUBLIC_FLAME_ADS_ENABLED=false
NEXT_PUBLIC_FLAME_ADS_API_URL=https://api.ads.flameph.org

# NegosyoDepot-owned Supabase project. Use separate staging and production projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# One-account sign-in. Prefer the site-specific key; the shared fallback is temporary.
SSO_SECRET_NEGOSYODEPOT=
SSO_SECRET=

# Fulfillment stays off until migrations, RLS tests, backups, and owner release approval pass.
NEXT_PUBLIC_FULFILLMENT_ENABLED=false

# Server-to-server integration keys. Never expose these through NEXT_PUBLIC_* names.
FLAME_PROFILE_SYNC_SECRET=
MARKETPLACE_CATALOG_SYNC_SECRET=
INTEGRATION_EVENT_SIGNING_SECRET=
